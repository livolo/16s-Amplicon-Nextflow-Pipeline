params {
    // Input files: pass your own paths with --manifest, --metadata, etc.
    manifest   = "metadata/manifest.tsv"
    metadata   = "metadata/sample-metadata.tsv"
    classifier = "reference/silva-138-99-515-806-nb-classifier.qza"
    outdir     = "results"

    // DADA2 settings
    trunc_len_f = 145
    trunc_len_r = 130
    trim_left_f = 0
    trim_left_r = 0

    // Diversity settings
    sampling_depth        = 8107
    max_rarefaction_depth = 19000

    // Metadata column used for group comparisons
    group_column = "Health_State"
    qiime_container  = "qiime2.sif"
    r_container      = "R.sif"
    singularity_opts = ""

        // Container images (set these to your own paths)
    qiime_container  = "qiime2.sif"   // QIIME 2 Singularity image
    r_container      = "R.sif"        // built from R.def
    singularity_opts = ""             // for example "--bind /data"
}

process {
    executor = 'local'

    withName: IMPORT_DATA {
        cpus      = 2
        memory    = '8 GB'
        time      = '2h'
        container = params.qiime_container
    }

    withName: DENOISE {
        cpus      = 8
        memory    = '32 GB'
        time      = '6h'
        container = params.qiime_container
    }

    withName: PHYLOGENY {
        cpus      = 8
        memory    = '16 GB'
        time      = '2h'
        container = params.qiime_container
    }

    withName: TAXONOMY {
        cpus      = 8
        memory    = '32 GB'
        time      = '4h'
        container = params.qiime_container
    }

    withName: CORE_DIVERSITY {
        cpus      = 8
        memory    = '16 GB'
        time      = '2h'
        container = params.qiime_container
    }

    withName: ALPHA_GROUP_SIGNIFICANCE {
        cpus      = 2
        memory    = '4 GB'
        time      = '30m'
        container = params.qiime_container
    }

    withName: ALPHA_RAREFACTION {
        cpus      = 4
        memory    = '8 GB'
        time      = '1h'
        container = params.qiime_container
    }

    withName: DIFFERENTIAL_ABUNDANCE {
        cpus      = 4
        memory    = '8 GB'
        time      = '1h'
        container = params.qiime_container
    }

    withName: R_REPORT {
        cpus      = 2
        memory    = '4 GB'
        time      = '30m'
        container = params.r_container
    }
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = false
        singularity.runOptions = params.singularity_opts
    }
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_report_executionFile.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/trace.txt"
}
